  <!-- Script untuk meng-update elemen <time> (Waktu Real-time) -->
  <script>
    function updateTime() {
      const timeElement = document.getElementById('current-time');
      const now = new Date();
      const options = { 
        weekday: 'long', 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
      };
      timeElement.textContent = now.toLocaleDateString('id-ID', options);
    }
    
    updateTime();
    setInterval(updateTime, 1000);
  </script>

